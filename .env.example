# Скопіюй цей файл у .env і впиши свої значення.
# .env у .gitignore — у репозиторій він не потрапить. Ніколи не коміть токени.

# ---------------------------------------------------------------- Telegram
TELEGRAM_BOT_TOKEN=123456789:AA-твій-токен-від-BotFather
TELEGRAM_CHANNEL_ID=@username_каналу_або_-1001234567890
# 1 = нічого не публікувати (тільки показ), 0 = публікувати
DRY_RUN=1
# Максимум новин за один запуск
MAX_ITEMS=10
# 1 = спробувати переклад PL->UA (безкоштовний сервіс, нестабільний)
TRANSLATE=0

# ------------------------------------------- GitHub (панель і самоланцюжок)
# Fine-grained PAT зі scope "Actions: read and write".
# У GitHub Actions він живе як секрет GH_PAT, локально — як GH_TOKEN.
# GH_TOKEN=
# Альтернатива: файл, у якому лежить токен.
# GH_TOKEN_FILE=
# Шлях до gh.exe, якщо GitHub CLI не в PATH.
# GH_BIN=
# WRONKI_REPO=enterpriseimpossible-sudo/wronki-news-bot

# ------------------------------------------------- сторож (monitor.py)
# chat_id, куди надсилати алерти. Це НЕ канал: у канал алерт не піде.
# WRONKI_ALERT_CHAT_ID=
